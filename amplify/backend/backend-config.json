{
    "api": {
        "mehoadminapi": {
            "service": "AppSync",
            "providerPlugin": "awscloudformation",
            "output": {
                "authConfig": {
                    "additionalAuthenticationProviders": [],
                    "defaultAuthentication": {
                        "authenticationType": "API_KEY",
                        "apiKeyConfig": {
                            "description": "mehoadmin",
                            "apiKeyExpirationDays": "365"
                        }
                    }
                }
            }
        }
    },
    "auth": {
        "mehousers": {
            "service": "Cognito",
            "providerPlugin": "awscloudformation",
            "dependsOn": []
        }
    },
    "storage": {
        "mehoassets": {
            "service": "S3",
            "providerPlugin": "awscloudformation"
        }
    },
    "hosting": {
        "amplifyhosting": {
            "service": "amplifyhosting",
            "providerPlugin": "awscloudformation",
            "type": "manual"
        }
    }
}